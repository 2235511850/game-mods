# ============ 发布产物 ============
# 交付给别人的 zip 不进仓库，需要时跑 tools 里的脚本重新生成
dist/release/*.zip

# 打包工作目录（每次打包由脚本重建）
dist/release/_build/pack_mod/
dist/release/_build/pack_full/

# 由 doc_mod.utf8.txt 转码生成的中间文件
dist/release/_build/doc_mod.txt

# ============ 第三方代码，不进仓库 ============
# 从别人 pak 里提取的明文 JS，仅作研究参考，不随仓库分发
PBZ_DamageNumbers_Custom/reference/SLEEP_PBZDamageNumbers.js.txt

# ============ mod 运行时产物 ============
# CET 会在 mod 目录里生成 config.json / debug.log / db.sqlite3
# 测试脚本用临时目录，但手跑（cwd 停在 _test）时可能落在这里
CP77_GameSpeedControl/**/config.json
CP77_GameSpeedControl/**/debug.log
*.sqlite3

# ============ 工具目录 ============
.workbuddy/

# ============ Python ============
__pycache__/
*.pyc

# ============ 系统 ============
Thumbs.db
desktop.ini
.DS_Store
